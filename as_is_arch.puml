@startuml
title Контекстная диаграмма системы "Умный дом" (с доменами)

actor "Пользователь" as User
rectangle "Датчик температуры" as Sensor

rectangle "Монолитное приложение\n(Go + PostgreSQL)" as Monolith {
    rectangle "Домен: Управление отоплением\n- включение/выключение\n- установка температуры\n- переключение режимов\n- команды устройствам" as Heating

    rectangle "Домен: Мониторинг температуры\n- опрос датчиков (pull)\n- сохранение показаний\n- проверка порогов (≥18°C)\n- предоставление данных" as Monitoring

    rectangle "Домен: Уведомления\n- формирование сообщений\n- отправка (email, push)\n- хранение истории" as Notifications

    rectangle "Домен: Учёт пользователей\n- регистрация\n- аутентификация\n- управление ролями\n- проверка прав доступа" as Users

    database "PostgreSQL" as DB
}

' Внешние взаимодействия (как в примере — с указанием протоколов)
User --> Monolith : "HTTPS (вкл/выкл, просмотр)"
Monolith --> Sensor : "Синхронный запрос (температура)"

' Связи с БД
Heating --> DB : "SQL (состояние, режимы, цель)"
Monitoring --> DB : "SQL (показания, зоны)"
Notifications --> DB : "SQL (настройки, история)"
Users --> DB : "SQL (пользователи, роли)"

' Внутренние взаимодействия — это и есть границы контекстов
Heating --> Monitoring : "Запрос текущей температуры (только значение)"
Monitoring --> Notifications : "Триггер: падение температуры"
Heating --> Notifications : "Триггер: включение/выключение"
Users --> Heating : "Проверка прав доступа (роль)"

@enduml