@startuml
'!include C4_Context.puml
'!include C4_Container.puml
'!include C4_Component.puml

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(client, "Client", "Пользователь системы")
System_Boundary(system, "Система скидок") {
    System(discountService, "DiscountService", "Сервис обработки скидок")
    System(userProfileService, "UserProfileService", "Сервис профилей пользователей")
}

Rel(client, discountService, "Request Discount", "HTTP")
Rel(discountService, userProfileService, "Fetch User Category", "gRPC")
Rel_R(userProfileService, discountService, "Provide User Category", "gRPC")


@enduml
