@startuml C4

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title
    <b>Система управления отоплением</b>
end title

Person(user, "Пользователь")

System_Boundary(boundary, "Система"){
    Container(react, "Web")
    Container(balanser, "Nginx")
    Container(api, "API")
}
database "Postgres" as db

Rel(user, react, "запрос")
Rel(react, balanser, "post")
Rel(balanser, api, "post")
Rel(api, db, "log")
Rel(api, balanser, "200 Ok")
Rel(balanser, react, "200 Ok")

@enduml