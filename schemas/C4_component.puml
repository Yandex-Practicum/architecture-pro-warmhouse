@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container_Boundary(smartHomeSystem, "SmartHome System") {
    Container(apiGW, "API GateWay", "Java/NodeJs", "Вэб-вервисы для пользователей и мобильных приложений")
    Container(userService, "User Service", "Java|Go", "Сервис управления домами и пользователями")
    Container(telemetryService, "Telemetry Service", "Go|Python", "Сервис взаимодействия с устройствами для получения телеметрии")
    Container(deviceService, "Device Service", "Java|Go", "Сервис управления устройствами") {

        Component(deviceAuthorizer, "Device Authorizer", "Привязка устройств к пользователям и проверка прав")
        ComponentDb(deviceRepository, "Device Repository", "Инкапсуляция взаимодействия с БД")
        Component(deviceAPIController, "Device API Controller", "Логика управления устройствами в домах пользователей")

        ComponentQueue(eventsPublisher, "Device Events Publisher")
        ComponentQueue(eventConsumer, "Device Events Consumer")
        Component(eventProcessor, "Device Events Processor", "Обрабатывает события от устройств")
    }
    ContainerDb(deviceDatabase, "Device Database", "PostgreSQL", "БД устройств")
    Container(auditTrails, "Audit Trails", "Python", "Аудитные события устройств")
}

Component_Ext(smartDevices ,"SmartDevices", "Внешние устройства в домах пользователей")

Rel(deviceRepository, deviceDatabase, "Чтение/запись", "SQL")

Rel(telemetryService, deviceAPIController, "Получает метаинформацию об устройствах", "REST")

Rel(apiGW, deviceAPIController, "CRUD устройств", "REST")

Rel(deviceAPIController, deviceRepository, "CRUD устройств")

Rel(deviceAPIController, deviceAuthorizer, "Привязка устройства к дому/пользователю", "REST")
Rel(deviceAuthorizer, userService, "Привязка устройства к дому/пользователю", "REST")

Rel(eventConsumer, eventProcessor, "События start|stop от устройств")
Rel(eventProcessor, deviceAuthorizer, "Авторизация устройств")
Rel(eventProcessor, deviceRepository, "Включение/отключение устройств")

Rel(deviceAPIController, eventsPublisher, "Управляющие команды для устройств")
Rel(eventsPublisher, auditTrails, "Аудитные события устройств", "MQ")
Rel(eventsPublisher, smartDevices, "Управляющие команды для устройств", "MQ")
Rel(eventsPublisher, telemetryService, "События на подчистку метрик", "MQ")
Rel(smartDevices, eventConsumer, "Сообщения start|stop от внешних устройств")

@enduml
