@startuml source

''' init layout

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()
skinparam linetype ortho
skinparam nodesep 150
skinparam ranksep 100
skinparam sequenceMessageAlign center

<style>
arrow {
    FontName Arial
    FontSize 12
    FontStyle italic
    FontColor black
}
</style>

''' end init layout

title
    <b>Система управления отоплением</b>
    <i> Схема TO-BE </i>
    <i> C1 - Containers </i>
end title

Person(admin, "Administrator", "Manage system")
Person_Ext(user, "User", "User, who get sensor's data")

System_Boundary(sourceSystem, "Main system") {
    Container(spa, "WebApplication", "React", "User interactions")
    Container(spaAdmin, "Admin panel", "React")
    Container(iam, "IAM ", "keycloak", "Identity and access")

    Container(bff_Api, "public API", "golang", "Back-For-Front")

    Container(get_handler, "Get Handler", "golang", "Get data from sensors and store it in cache")

    Container(settings_handler, "Settings Handler", "golang", "Manage sensors' settings")

    SystemDb(cache, "Sensors Cache", "Store Data from sensors")

    SystemDb(main_db, "System Storage", "Store settings for all sensors")

    SystemDb(log_db, "Log Storage", "Store all events for all sensors")

    SystemDb(data_bus, "Data bus", "Data to / from sensors")
}

System_Boundary(client, "Local temperature sensor") {
    System_Ext(sensor, "Temperature sensor"){
        Component_Ext(sensorApi, "Sensor API", "ASP.NET", "Manage concrete sensor")
        Component_Ext(sensorEmbedded, "Current sensor", "C/C++", "Low-Level operating sensor")

        Rel_D(sensorApi, sensorEmbedded, "Manage sensor", "InteropServices")
    }   
}

Rel(user, spa, "Interact with web app")
Rel_R(spa, iam, "check")
Rel(spa, bff_Api, "")

Rel(bff_Api, cache, "")
Rel(bff_Api, main_db, "")
Rel(bff_Api, data_bus, "")

Rel(admin, spaAdmin, "manage sensors and settings")
Rel_L(spaAdmin, iam, "check or/and manage accounts")
Rel_D(spaAdmin, settings_handler, "manage sensors")

Rel_D(settings_handler, data_bus, "")

Rel(get_handler, data_bus, "")
Rel(get_handler, sensorApi, "")
Rel(cache, log_db, "")
Rel_D(get_handler, cache, "")

@enduml